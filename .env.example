VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NÃO colocar valores reais

# ── "Abrir no Google Docs" (piloto PAEE) ──────────────────────────────────────
# Client ID OAuth 2.0 (tipo "Web application") do Google Cloud — é CONFIGURAÇÃO
# PÚBLICA (não é segredo), por isso pode ir em variável VITE_*. O client secret
# NUNCA existe neste projeto: o fluxo usado (Google Identity Services, "token
# model") não usa client secret. Sem esta variável (ou com um valor que não
# termine em ".apps.googleusercontent.com"), o botão "Abrir no Google Docs"
# fica oculto — ver src/config/googleDriveConfig.ts e o checklist de
# configuração externa no relatório desta fase.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ── OpenAI (SOMENTE backend — Vercel Environment Variables) ───────────────────
# NUNCA prefixar com VITE_: isso exporia a chave no bundle do frontend.
# Configure em: Vercel → Project → Settings → Environment Variables → OPENAI_API_KEY
# OPENAI_API_KEY=sk-...   ← NÃO colocar aqui nem no .env local